{#
    Piezas de las categorías que comparten el listado (escritorio y móvil), el
    resumen y el formulario del modal.

    Uso:
        {% import 'category/_macros.html.twig' as cat %}
        {{ cat.avatar(category.name, category.color) }}
        {{ cat.used_as(usage[category.id] ?? []) }}
#}

{# Cuadrado con la inicial sobre el color de la categoría. El color del texto se
   calcula para que se lea sobre cualquier color, también uno personalizado. Sin
   color, los neutros del tema. #}
{% macro avatar(name, color, size = '2rem') %}
    <span class="category-avatar"
          style="--category-avatar-size: {{ size }};{% if color %} background-color: {{ color }}; color: {{ color|contrast_text }};{% endif %}"
          aria-hidden="true">{{ name|first|upper }}</span>
{%- endmacro %}

{# Tipos de movimiento con los que se ha usado la categoría. counts: nº de
   movimientos por tipo, de CategoryUsage::countsByCategory(). #}
{% macro used_as(counts) %}
    {% if (counts.expense ?? 0) > 0 or (counts.income ?? 0) > 0 %}
        <span class="d-inline-flex flex-wrap gap-1">
            {% if (counts.expense ?? 0) > 0 %}
                <span class="badge rounded-pill bg-danger-subtle text-danger fw-normal">Gastos</span>
            {% endif %}
            {% if (counts.income ?? 0) > 0 %}
                <span class="badge rounded-pill bg-success-subtle text-success fw-normal">Ingresos</span>
            {% endif %}
        </span>
    {% else %}
        <span class="small text-body-secondary">Sin uso aún</span>
    {% endif %}
{%- endmacro %}

{# Línea corta de uso para la lista de móvil: «112 mov. · Gastos e ingresos». #}
{% macro usage_line(counts) %}
    {%- set expense = counts.expense ?? 0 -%}
    {%- set income = counts.income ?? 0 -%}
    {%- if expense + income == 0 -%}
        Sin uso aún
    {%- else -%}
        {{ (expense + income)|number_format(0, ',', '.') }} mov. ·
        {{ expense > 0 and income > 0 ? 'Gastos e ingresos' : (expense > 0 ? 'Gastos' : 'Ingresos') }}
    {%- endif -%}
{%- endmacro %}

{# Texto de la confirmación de borrado. total: movimientos que se quedarán sin
   categoría (las plantillas no tienen). #}
{% macro delete_message(name, total, isTemplate) %}
    {%- if isTemplate -%}
        ¿Eliminar la plantilla «{{ name }}»?
    {%- elseif total == 0 -%}
        ¿Eliminar la categoría «{{ name }}»?
    {%- elseif total == 1 -%}
        ¿Eliminar la categoría «{{ name }}»? Su movimiento quedará sin categoría.
    {%- else -%}
        ¿Eliminar la categoría «{{ name }}»? Sus {{ total|number_format(0, ',', '.') }} movimientos quedarán sin categoría.
    {%- endif -%}
{%- endmacro %}

{# Importe con signo según el tipo, en el formato del resto de la app. #}
{% macro amount(value, type, symbol = '') %}
    {{- type == 'expense' ? '-' : '+' }}{{ value|number_format(2, ',', '.') }}{{ symbol ? ' ' ~ symbol -}}
{% endmacro %}
