{% extends 'base.html.twig' %}

{% block title %}Enlace no válido{% endblock %}

{% block content %}
    {#
     # Enlace de restablecer contraseña que no se puede usar.
     # reason: invalid (no existe: mal copiado o se pidió otro después) | used | expired
     #}
    {% set messages = {
        invalid: 'Este enlace no es válido. Puede que esté incompleto o que hayas pedido otro después: solo funciona el último que te enviamos.',
        used: 'Este enlace ya se usó para cambiar la contraseña. Cada enlace solo sirve una vez.',
        expired: 'Este enlace ha caducado. Por seguridad, los enlaces para restablecer la contraseña duran 3 horas.',
    } %}

    <div class="d-flex justify-content-center align-items-center h-100">
        <main class="form-wrapper">
            <h1 class="text-center mb-3">Enlace no válido</h1>

            <div class="p-4 p-md-5 border rounded-3 bg-body-tertiary">
                <p class="mb-4">{{ messages[reason] }}</p>

                {# Con sesión, el botón para pedir otro está en Cambiar contraseña #}
                {% if app.user %}
                    <a class="w-100 btn btn-lg btn-primary" href="{{ path('app_profile_password') }}">Pedir otro enlace</a>
                {% else %}
                    <a class="w-100 btn btn-lg btn-primary" href="{{ path('app_forgot_password') }}">Pedir otro enlace</a>

                    <hr class="my-4">

                    <small class="text-muted text-center d-block">
                        ¿Has recordado la contraseña? <a href="{{ path('app_login') }}">Login</a>
                    </small>
                {% endif %}
            </div>
        </main>
    </div>
{% endblock %}
