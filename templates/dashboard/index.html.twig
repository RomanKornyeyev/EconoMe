{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{# Chart.js por los graficos; flatpickr por el modal de nuevo movimiento. #}
{% block page_assets %}
    {% include 'partials/assets/_chartjs.html.twig' %}
    {% include 'partials/assets/_flatpickr.html.twig' %}
{% endblock %}

{% block content %}
{% if not hasAccounts %}
    {% include 'partials/_no_account.html.twig' with {message: 'Crea tu primera cuenta para empezar a visualizar las métricas.'} %}
{% else %}

{% import 'partials/macros/_tour.html.twig' as tour %}

{# pb-5 en móvil: el FAB flota sobre el final de la página. #}
<div class="pb-5 pb-lg-0" {{ tour.attrs('dashboard') }}>

{# Zonas 1 y 2: cabecera — cuenta, período y acciones #}
{% include 'dashboard/_header.html.twig' %}


{# Zona 3: KPIs #}
{% include 'components/_stats_cards.html.twig' %}

{# Zona 4: Gráficos #}
{% include 'components/_charts.html.twig' %}

{# Zona 5: Movimientos #}
<div class="card border shadow-sm" id="table_transactions" data-controller="bulk-select"
     data-tour-step="5"
     data-tour-title="Movimientos del período"
     data-tour-text="Los movimientos de la cuenta en el período seleccionado. Desde «Ver todos» accedes al listado completo con filtros avanzados."
     data-tour-side="top">
    <div class="card-header bg-body-tertiary border-bottom d-flex align-items-center">
        {# Estado normal #}
        <div data-bulk-select-target="normalBar" class="d-flex justify-content-between align-items-center w-100">
            <h5 class="mb-0">Movimientos <span class="text-muted fw-normal small">{{ periodLabel }}</span></h5>
            <a href="{{ path('transaction_index', {account: currentAccount.id}) }}"
               class="btn btn-sm btn-outline-secondary">Ver todos</a>
        </div>
        {# Estado bulk #}
        {% include 'transaction/_table_bulk_bar.html.twig' %}
    </div>

    {# Tabla desktop: visible en md+ #}
    <div class="d-none d-md-block">
        {% include 'transaction/_table_desktop.html.twig' %}
    </div>

    {# Cards mobile: visible en < md #}
    <div class="d-md-none">
        {% include 'transaction/_cards_mobile.html.twig' %}
    </div>
</div>

{% include 'partials/_pagination_bar.html.twig' with {
    pagination: transactions,
    perPageOptions: perPageOptions,
    anchor: 'table_transactions',
    itemLabel: 'movimiento',
    itemLabelPlural: 'movimientos',
} only %}

{# Botón flotante de «Nuevo movimiento»: sustituye en móvil al botón de la
   cabecera. Lleva su mismo paso del tour; el tour ignora el que esté oculto,
   así que en cada tamaño se señala el visible. #}
<button class="dash-fab btn btn-primary rounded-circle shadow position-fixed bottom-0 end-0 m-3 d-lg-none"
        data-bs-toggle="modal" data-bs-target="#transactionModal"
        aria-label="Nuevo movimiento"
        data-tour-step="6"
        data-tour-title="Añade movimientos"
        data-tour-text="Registra un gasto o un ingreso sin salir del dashboard.">
    <i class="fa-solid fa-plus"></i>
</button>

{% include 'transaction/_modal_transaction.html.twig' %}
{% include 'transaction/_modal_summary.html.twig' %}

</div> {# /tour #}

{% endif %}
{% endblock %}
