{#
    Panel «Presupuestos» del dashboard: cómo va cada presupuesto en el periodo
    que se mira. Diseño en claude/presupuestos.md §5.1.

    Una fila por presupuesto, ordenadas por urgencia (BudgetEvaluator). Cada fila
    lleva a sus movimientos de esas fechas (budget_transactions). Los datos vienen
    calculados (BudgetPanel, BudgetRow); aquí solo se componen los textos.

    Espera en contexto:
    - budgetPanel:    App\Budget\BudgetPanel
    - currentAccount, year, month
#}
{% import 'budget/_macros.html.twig' as bm %}
{% set currency = currentAccount.currency %}
{% set panel = budgetPanel %}

{# Pista del periodo, en la cabecera. #}
{% if panel.yearView %}
    {% set hint = panel.tense == 'past' ? 'Año cerrado' : (panel.tense == 'future' ? 'Aún no ha empezado' : 'En curso') %}
{% elseif panel.tense == 'current' %}
    {% set hint = 'Día ' ~ 'now'|date('j') ~ ' de ' ~ 'now'|date('t') %}
{% else %}
    {% set hint = panel.tense == 'past' ? 'Mes cerrado' : 'Aún no ha empezado' %}
{% endif %}

<div class="card border shadow-sm mb-3" id="presupuestos">
    <div class="card-header bg-body-tertiary border-bottom d-flex flex-wrap align-items-center gap-2">
        <h5 class="mb-0">Presupuestos <span class="text-muted fw-normal small">{{ panel.label }}</span></h5>
        <span class="small text-body-secondary">{{ hint }}</span>
        <a href="{{ path('budget_index', {account: currentAccount.id}) }}" class="btn btn-sm btn-outline-secondary ms-auto">Gestionar</a>
    </div>

    {# Resumen de lo cerrado, o de lo que aún no ha empezado. #}
    {% set summary = null %}
    {% if panel.yearView and panel.periodsPercent is not null %}
        {% set summary = 'En ' ~ panel.label ~ ' has cumplido el ' ~ panel.periodsPercent ~ ' % de tus periodos cerrados (' ~ panel.periodsMet ~ ' de ' ~ panel.periodsClosed ~ ').' %}
    {% elseif not panel.yearView and panel.tense == 'past' and panel.evaluated|length > 0 %}
        {% set evaluated = panel.evaluated|length %}
        {% if panel.successCount == evaluated %}
            {% set summary = '¡' ~ panel.label|capitalize ~ ' cerrado: cumpliste ' ~ (evaluated == 1 ? 'tu presupuesto' : 'todos tus presupuestos') ~ '!' %}
        {% else %}
            {% set summary = panel.label|capitalize ~ ' cerrado: cumpliste ' ~ panel.successCount ~ ' de ' ~ evaluated ~ '.' %}
        {% endif %}
        {% if panel.runningCount > 0 %}
            {% set summary = summary ~ ' ' ~ (panel.runningCount == 1 ? 'Uno sigue en curso.' : panel.runningCount ~ ' siguen en curso.') %}
        {% endif %}
    {% elseif panel.tense == 'future' %}
        {% set summary = panel.label|capitalize ~ ' aún no ha empezado.' %}
    {% endif %}
    {% if summary %}
        <div class="px-3 py-2 border-bottom small">{{ summary }}</div>
    {% endif %}

    <div class="list-group list-group-flush">
        {% for row in panel.rows %}
            {% set budget = row.budget %}
            {% set outcome = row.outcome %}
            {% set tone = outcome.tone %}

            {# Detalle bajo el título del estado. #}
            {% set excess = row.spent - (row.limit ?? 0) %}
            {% if row.summary %}
                {% set names = row.failed|map(p => p.labelWithoutYear) %}
                {% if row.failed is empty %}
                    {% set detail = row.closed ~ ' de ' ~ row.closed ~ ' ' ~ budget.frequency.unitPlural %}
                {% elseif row.failed|length <= 3 %}
                    {% set detail = (budget.expense ? 'Te pasaste en ' : 'No llegaste en ') ~ names|join(', ', ' y ') %}
                {% else %}
                    {% set detail = (budget.expense ? 'Te pasaste en ' : 'No llegaste en ') ~ row.failed|length ~ ' ' ~ budget.frequency.unitPlural %}
                {% endif %}
            {% elseif outcome.value == 'pending' %}
                {% set detail = row.usualAmount ? 'Importe especial: normalmente ' ~ bm.money(row.usualAmount, currency) : '' %}
            {% elseif outcome.value in ['on_track', 'near'] %}
                {% set detail = 'Quedan ' ~ bm.money(row.remaining, currency)
                    ~ (row.recurring > 0 ? ' · ' ~ bm.money(row.recurring, currency) ~ ' son recurrentes'
                        : (row.perDay ? ' · ' ~ bm.money(row.perDay, currency) ~ '/día' : '')) %}
            {% elseif outcome.value == 'over' %}
                {% set detail = bm.money(excess, currency) ~ ' por encima'
                    ~ (row.daysLeft > 0 ? ' · ' ~ (row.daysLeft == 1 ? 'queda 1 día' : 'quedan ' ~ row.daysLeft ~ ' días') : '') %}
            {% elseif outcome.value == 'goal_pending' %}
                {% set detail = 'Te faltan ' ~ bm.money(row.remaining, currency)
                    ~ (row.daysLeft > 0 ? ' · ' ~ (row.daysLeft == 1 ? 'queda 1 día' : 'quedan ' ~ row.daysLeft ~ ' días') : '') %}
            {% elseif outcome.value == 'goal_reached' %}
                {% set detail = excess > 0 ? bm.money(excess, currency) ~ ' por encima de tu meta' : 'Justo en la meta' %}
            {% elseif outcome.value == 'running' %}
                {% set detail = 'Se evalúa al terminar ' ~ row.period.label %}
            {% elseif outcome.value == 'met' %}
                {% set detail = row.remaining > 0 ? 'Te sobraron ' ~ bm.money(row.remaining, currency) : 'Justo en el límite' %}
            {% elseif outcome.value == 'exceeded' %}
                {% set detail = bm.money(excess, currency) ~ ' por encima del límite' %}
            {% elseif outcome.value == 'goal_missed' %}
                {% set detail = 'Te faltaron ' ~ bm.money(row.remaining, currency) %}
            {% else %}
                {% set detail = '' %}
            {% endif %}

            {# Línea bajo el nombre: tipo y frecuencia, y el periodo cuando no es el
               mes que se mira (la semana, el trimestre…). #}
            {% set showRange = not row.summary and budget.frequency.value != 'monthly' and not (panel.yearView and budget.frequency.value == 'yearly') %}
            {% set meta = budget.kindLabel
                ~ (budget.accountWide ? ' · toda la cuenta' : '')
                ~ (showRange ? ' · ' ~ row.period.rangeLabel : '')
                ~ (row.usualAmount and outcome.value != 'pending' ? ' · importe especial' : '') %}

            <a href="{{ path('budget_transactions', {id: budget.id, from: row.from.start|date('Y-m-d'), to: row.to.end|date('Y-m-d'), year: year, month: month}) }}"
               class="list-group-item list-group-item-action py-3">
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-md-3 min-w-0">
                        <div class="d-flex align-items-center gap-2 fw-semibold">
                            {{ bm.dot(budget) }}<span class="text-truncate">{{ budget.name }}</span>
                        </div>
                        <div class="small text-body-secondary">{{ meta }}</div>
                    </div>

                    <div class="col-12 col-md-4">
                        {{ bm.bar(row.barPercent, tone, row.marker, row.summary
                            ? row.met ~ ' de ' ~ row.closed ~ ' cumplidos'
                            : row.percent ~ ' % del ' ~ (budget.expense ? 'límite' : 'objetivo')) }}
                    </div>

                    <div class="col-5 col-md-2 text-md-end text-nowrap">
                        {% if row.summary %}
                            <span class="fw-semibold">{{ row.met }} de {{ row.closed }}</span>
                            <span class="small text-body-secondary">{{ budget.frequency.unitPlural }}</span>
                        {% else %}
                            <span class="fw-semibold">{{ bm.money(row.spent, currency) }}</span>
                            <div class="small text-body-secondary">de {{ bm.money(row.limit, currency) }}{% if outcome.value != 'pending' %} · {{ row.percent }} %{% endif %}</div>
                        {% endif %}
                    </div>

                    <div class="col-7 col-md-3 d-flex align-items-start gap-2 min-w-0">
                        <i class="fa-solid {{ outcome.icon }} text-{{ tone }}-emphasis mt-1" aria-hidden="true"></i>
                        <div class="min-w-0">
                            <div class="small fw-semibold text-{{ tone }}-emphasis">{{ outcome.title }}</div>
                            {% if detail %}<div class="small text-body-secondary">{{ detail }}</div>{% endif %}
                        </div>
                    </div>
                </div>
            </a>
        {% endfor %}
    </div>

    <div class="card-footer bg-body-tertiary small text-body-secondary d-flex flex-wrap gap-2 column-gap-4">
        {% if panel.rows|filter(r => r.marker is not null)|length > 0 %}
            <span class="d-inline-flex align-items-center gap-2">
                <span class="budget-bar__legend-marker" aria-hidden="true"></span>Hoy: dónde irías gastando a ritmo constante
            </span>
            <span>Aviso de «cerca del límite» a partir del 80 %</span>
        {% endif %}
        <span>Pulsa un presupuesto para ver sus movimientos</span>
    </div>
</div>
