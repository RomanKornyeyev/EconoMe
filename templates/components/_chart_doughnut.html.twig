{#
    Reparto por categoría del período: donut y desglose en lista, con salto al
    listado al pinchar un sector o una fila.

    Autónomo: monta su propia tarjeta, sus datos y su controlador, así que
    puede incluirse suelto en cualquier vista o, como en el dashboard, dentro
    de una pestaña.

    La leyenda del gráfico va apagada: en su lugar, debajo del donut, una lista
    ordenada de mayor a menor con color, nombre, porcentaje e importe. Las
    categorías que no entran en las primeras filas se despliegan con «Ver las
    N restantes», un collapse de Bootstrap.

    Espera en contexto:
    - expensesByCategory: sumByCategory() del repositorio (ya viene ordenado
                          por importe descendente)
    - categoryType:       'expense' | 'income' (el que se está viendo)
    - currentAccount, year, month: para los enlaces de cada categoría

    Variables opcionales:
    - titleClass:         clases del <h6> del título. El dashboard lo oculta en
                          móvil (d-none d-lg-block) porque ahí lo dice la pestaña.
    - visibleCategories:  filas visibles antes de desplegar (por defecto, 3)
#}
{% set titleClass        = titleClass|default('') %}
{% set visibleCategories = visibleCategories|default(3) %}
{% set nameMaxLength     = 20 %}

{# Un enlace por categoría: mismo período y tipo que el gráfico, filtrado por
   ella. Sin categoría (categoryId null) se traduce a category=-1, que el
   drilldown y transaction_index interpretan como «movimientos sin categoría».

   No se enlaza al listado directamente sino al drilldown del dashboard, que
   traduce estos parámetros a los filtros y de paso deja el aviso de qué se ha
   filtrado, con enlace de vuelta aquí. #}
{% set catTotal = 0 %}
{% for row in expensesByCategory %}
    {% set catTotal = catTotal + (row.total ?? 0) %}
{% endfor %}

{% set categories = [] %}
{% for row in expensesByCategory %}
    {% set name = row.categoryName ?? 'Sin categoría' %}
    {% set categories = categories|merge([{
        name:   name,
        color:  row.categoryColor ?? '#607D8B',
        total:  (row.total ?? 0) + 0,
        share:  catTotal > 0 ? (row.total ?? 0) / catTotal * 100 : 0,
        link:   path('dashboard_category_drilldown', {
            account:  currentAccount.id,
            year:     year,
            month:    month,
            type:     categoryType,
            category: row.categoryId ?? -1,
        }),
    }]) %}
{% endfor %}

{% set urlExpense = '?' ~ app.request.query.all|merge({'categoryType': 'expense'})|url_encode %}
{% set urlIncome  = '?' ~ app.request.query.all|merge({'categoryType': 'income'})|url_encode %}

{% macro categoryRow(item, maxLength) %}
    <a href="{{ item.link }}" class="dash-cat-row d-flex align-items-center gap-2 border-top text-decoration-none">
        <span class="dash-cat-row__dot rounded-circle flex-shrink-0" style="background: {{ item.color }}"></span>
        <span class="text-body text-truncate"
              {% if item.name|length > maxLength %}title="{{ item.name }}"{% endif %}>
            {{ item.name|length > maxLength ? item.name|slice(0, maxLength)|trim ~ '…' : item.name }}
        </span>
        {# «<1 %» y no «0 %»: una categoría que aparece en el gráfico siempre
           tiene importe, y un cero se leería como que no lo tiene. #}
        <span class="text-body fw-semibold ms-auto text-end dash-cat-row__share">
            {{ item.share > 0 and item.share < 0.5 ? '<1' : item.share|round }} %
        </span>
        <span class="text-muted text-end dash-cat-row__amount">{{ item.total|number_format(2, ',', '.') }} €</span>
    </a>
{% endmacro %}
{% import _self as widgets %}

<div class="card border shadow-sm bg-body-tertiary h-100"
     {% if expensesByCategory is not empty %}
     data-controller="chart-doughnut"
     data-chart-doughnut-categories-value="{{ {
         labels: categories|column('name'),
         values: categories|column('total'),
         colors: categories|column('color'),
         links:  categories|column('link'),
     }|json_encode }}"
     {% endif %}>
    <div class="card-header border-bottom d-flex justify-content-between align-items-center gap-2" style="min-height: 3rem;">
        <h6 class="mb-0 {{ titleClass }}">Por categoría</h6>
        <div class="btn-group btn-group-sm ms-auto" role="group">
            <a href="{{ urlExpense }}" class="btn {{ categoryType == 'expense' ? 'btn-secondary' : 'btn-outline-secondary' }}">Gastos</a>
            <a href="{{ urlIncome }}"  class="btn {{ categoryType == 'income'  ? 'btn-secondary' : 'btn-outline-secondary' }}">Ingresos</a>
        </div>
    </div>
    <div class="card-body">
        {% if expensesByCategory is empty %}
            <div class="d-flex flex-column justify-content-center align-items-center text-center h-100 gap-3 py-4">
                <p class="text-muted small mb-0">No hay {{ categoryType == 'income' ? 'ingresos' : 'gastos' }} en este período.</p>
                <div class="d-flex flex-column gap-2">
                    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#transactionModal">
                        <i class="fa-solid fa-plus me-1"></i>Añadir movimiento
                    </button>
                    <a href="{{ path('recurring_create', {account: currentAccount.id}) }}" class="btn btn-outline-primary btn-sm">
                        <i class="fa-solid fa-rotate me-1"></i>Añadir movimiento recurrente
                    </a>
                </div>
            </div>
        {% else %}
            <div class="dash-chart dash-chart--doughnut">
                <canvas data-chart-doughnut-target="canvas"></canvas>
            </div>

            {% set rest = categories|slice(visibleCategories) %}
            <div class="dash-cat-list mt-3">
                {% for item in categories|slice(0, visibleCategories) %}
                    {{ widgets.categoryRow(item, nameMaxLength) }}
                {% endfor %}

                {% if rest is not empty %}
                    <div class="collapse" id="dashCategoryRest">
                        {% for item in rest %}
                            {{ widgets.categoryRow(item, nameMaxLength) }}
                        {% endfor %}
                    </div>

                    <button type="button"
                            class="dash-cat-toggle btn btn-link btn-sm w-100 text-decoration-none border-top rounded-0"
                            data-bs-toggle="collapse" data-bs-target="#dashCategoryRest"
                            aria-expanded="false" aria-controls="dashCategoryRest">
                        <span class="dash-cat-toggle__more">
                            Ver {{ rest|length == 1 ? 'la restante' : 'las ' ~ rest|length ~ ' restantes' }}
                            <i class="fa-solid fa-caret-down ms-1"></i>
                        </span>
                        <span class="dash-cat-toggle__less">
                            Ver menos <i class="fa-solid fa-caret-up ms-1"></i>
                        </span>
                    </button>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>
