{% set queryParams = app.request.query.all|merge({'categoryType': 'expense'}) %}
{% set urlExpense = '?' ~ queryParams|url_encode %}
{% set queryParams = app.request.query.all|merge({'categoryType': 'income'}) %}
{% set urlIncome  = '?' ~ queryParams|url_encode %}

<div class="card border shadow-sm bg-body-tertiary h-100">
    <div class="card-header border-bottom d-flex justify-content-between align-items-center" style="min-height: 3rem;">
        <h6 class="mb-0">Por categoría</h6>
        <div class="btn-group btn-group-sm" role="group">
            <a href="{{ urlExpense }}" class="btn {{ categoryType == 'expense' ? 'btn-secondary' : 'btn-outline-secondary' }}">Gastos</a>
            <a href="{{ urlIncome }}"  class="btn {{ categoryType == 'income'  ? 'btn-secondary' : 'btn-outline-secondary' }}">Ingresos</a>
        </div>
    </div>
    <div class="card-body">
        {% if expensesByCategory is empty %}
            <div class="d-flex flex-column justify-content-center align-items-center text-center h-100 gap-3 py-4">
                <p class="text-muted small mb-0">No hay {{ categoryType == 'income' ? 'ingresos' : 'gastos' }} en este período.</p>
                <div class="d-flex flex-column gap-2">
                    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#transactionModal">
                        <i class="fa-solid fa-plus me-1"></i>Añadir movimiento
                    </button>
                    <a href="{{ path('recurring_create', {account: currentAccount.id}) }}" class="btn btn-outline-primary btn-sm">
                        <i class="fa-solid fa-rotate me-1"></i>Añadir movimiento recurrente
                    </a>
                </div>
            </div>
        {% else %}
            <canvas id="doughnutChart"></canvas>
        {% endif %}
    </div>
</div>

{% if expensesByCategory is not empty %}
{# Un enlace por sector: mismo período y tipo que el gráfico, filtrado por categoría.
   Sin categoría (categoryId null) se traduce a category=-1, que transaction_index
   interpreta como "movimientos sin categoría". #}
{% set categoryLinks = [] %}
{% for row in expensesByCategory %}
    {% set categoryLinks = categoryLinks|merge([path('transaction_index', {
        account:   currentAccount.id,
        date_from: from|date('Y-m-d'),
        date_to:   to|date('Y-m-d'),
        type:      categoryType,
        category:  row.categoryId ?? -1,
    })]) %}
{% endfor %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const canvas = document.getElementById('doughnutChart');
    const ctx = canvas.getContext('2d');
    const links = {{ categoryLinks|json_encode|raw }};

    // Sector cuyo tooltip ya estaba abierto justo antes del toque actual.
    // En táctil hace de confirmación: el primer toque solo abre el tooltip y el
    // segundo, sobre el mismo sector, navega. Así un toque accidental no saca
    // al usuario del dashboard. Con ratón se navega al primer clic.
    let armedIndex  = null;
    let pointerType = 'mouse';

    function goToCategory(index) {
        if (links[index]) {
            window.location.href = links[index];
        }
    }

    const chart = new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: [{% for row in expensesByCategory %}'{{ row.categoryName ?? "Sin categoría" }}',{% endfor %}],
            datasets: [{
                data: [{% for row in expensesByCategory %}{{ row.total }},{% endfor %}],
                backgroundColor: [{% for row in expensesByCategory %}'{{ row.categoryColor ?? "#607D8B" }}',{% endfor %}],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: true,
            aspectRatio: 1.2,
            cutout: '65%',
            onHover: function(event, elements) {
                canvas.style.cursor = elements.length ? 'pointer' : 'default';
            },
            onClick: function(event, elements) {
                if (!elements.length) {
                    return;
                }
                const index = elements[0].index;
                if (pointerType === 'touch' && armedIndex !== index) {
                    return; // primer toque: Chart.js ya ha abierto el tooltip
                }
                goToCategory(index);
            },
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: { boxWidth: 8, padding: 10, font: { size: 11 } },
                    // La leyenda navega en lugar de ocultar el sector: es un
                    // objetivo pequeño y explícito, no hace falta confirmar.
                    onClick: function(event, legendItem) {
                        goToCategory(legendItem.index);
                    }
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            const value = parseFloat(context.parsed) || 0;
                            const total = context.chart.data.datasets[0].data
                                .reduce((acc, v) => acc + (parseFloat(v) || 0), 0);
                            const porcentaje = total > 0 ? (value / total) * 100 : 0;

                            const importe = value.toLocaleString('es-ES', {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            });
                            const pct = porcentaje.toLocaleString('es-ES', {
                                minimumFractionDigits: 1,
                                maximumFractionDigits: 1
                            });

                            return ` ${importe} € (${pct}%)`;
                        }
                    }
                }
            }
        }
    });

    // pointerdown se dispara antes de que Chart.js procese el toque, así que aquí
    // el tooltip todavía refleja el estado *previo*: si ya estaba abierto sobre
    // este sector, el toque que viene es el segundo y puede navegar.
    canvas.addEventListener('pointerdown', function(event) {
        pointerType = event.pointerType || 'mouse';
        const active = chart.tooltip ? chart.tooltip.getActiveElements() : [];
        armedIndex = active.length ? active[0].index : null;
    }, { passive: true });
});
</script>
{% endif %}
