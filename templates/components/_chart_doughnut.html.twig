{#
    Reparto por categoría del período, con salto al listado al pinchar un
    sector.

    Autónomo: monta su propia tarjeta, sus datos y su controlador, así que
    puede incluirse suelto en cualquier vista o, como en el dashboard, dentro
    de una pestaña.

    Espera en contexto:
    - expensesByCategory: sumByCategory() del repositorio
    - categoryType:       'expense' | 'income' (el que se está viendo)
    - currentAccount, year, month: para los enlaces de cada sector

    Variables opcionales:
    - titleClass:         clases del <h6> del título. El dashboard lo oculta en
                          móvil (d-none d-lg-block) porque ahí lo dice la pestaña.
#}
{% set titleClass = titleClass|default('') %}

{# Un enlace por sector: mismo período y tipo que el gráfico, filtrado por
   categoría. Sin categoría (categoryId null) se traduce a category=-1, que el
   drilldown y transaction_index interpretan como «movimientos sin categoría».

   No se enlaza al listado directamente sino al drilldown del dashboard, que
   traduce estos parámetros a los filtros y de paso deja el aviso de qué se ha
   filtrado, con enlace de vuelta aquí. #}
{% set catLabels = [] %}
{% set catValues = [] %}
{% set catColors = [] %}
{% set catLinks  = [] %}
{% for row in expensesByCategory %}
    {% set catLabels = catLabels|merge([row.categoryName ?? 'Sin categoría']) %}
    {% set catValues = catValues|merge([(row.total ?? 0) + 0]) %}
    {% set catColors = catColors|merge([row.categoryColor ?? '#607D8B']) %}
    {% set catLinks  = catLinks|merge([path('dashboard_category_drilldown', {
        account:  currentAccount.id,
        year:     year,
        month:    month,
        type:     categoryType,
        category: row.categoryId ?? -1,
    })]) %}
{% endfor %}

{% set urlExpense = '?' ~ app.request.query.all|merge({'categoryType': 'expense'})|url_encode %}
{% set urlIncome  = '?' ~ app.request.query.all|merge({'categoryType': 'income'})|url_encode %}

<div class="card border shadow-sm bg-body-tertiary h-100"
     {% if expensesByCategory is not empty %}
     data-controller="chart-doughnut"
     data-chart-doughnut-categories-value="{{ {
         labels: catLabels,
         values: catValues,
         colors: catColors,
         links:  catLinks,
     }|json_encode }}"
     {% endif %}>
    <div class="card-header border-bottom d-flex justify-content-between align-items-center gap-2" style="min-height: 3rem;">
        <h6 class="mb-0 {{ titleClass }}">Por categoría</h6>
        <div class="btn-group btn-group-sm ms-auto" role="group">
            <a href="{{ urlExpense }}" class="btn {{ categoryType == 'expense' ? 'btn-secondary' : 'btn-outline-secondary' }}">Gastos</a>
            <a href="{{ urlIncome }}"  class="btn {{ categoryType == 'income'  ? 'btn-secondary' : 'btn-outline-secondary' }}">Ingresos</a>
        </div>
    </div>
    <div class="card-body">
        {% if expensesByCategory is empty %}
            <div class="d-flex flex-column justify-content-center align-items-center text-center h-100 gap-3 py-4">
                <p class="text-muted small mb-0">No hay {{ categoryType == 'income' ? 'ingresos' : 'gastos' }} en este período.</p>
                <div class="d-flex flex-column gap-2">
                    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#transactionModal">
                        <i class="fa-solid fa-plus me-1"></i>Añadir movimiento
                    </button>
                    <a href="{{ path('recurring_create', {account: currentAccount.id}) }}" class="btn btn-outline-primary btn-sm">
                        <i class="fa-solid fa-rotate me-1"></i>Añadir movimiento recurrente
                    </a>
                </div>
            </div>
        {% else %}
            <div class="dash-chart dash-chart--doughnut">
                <canvas data-chart-doughnut-target="canvas"></canvas>
            </div>
        {% endif %}
    </div>
</div>
