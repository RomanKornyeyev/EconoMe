{% extends 'base.html.twig' %}

{% block title %}{{ account.name }}{% endblock %}

{#
    Ficha de cuenta: la única vista de cuentas. No hay listado ni papelera
    aparte; se cambia de cuenta, y se llega a las de la papelera, con el
    selector de la cabecera.

    Dos modos:
    - Activa: el cuerpo (account/_body) tal cual.
    - Papelera (isTrashed): el mismo cuerpo, difuminado e inert, con un panel
      de acciones encima. La cabecera (título, selector y ayuda) sigue usable.
      El dueño puede restaurarla o, pasado el enfriamiento, eliminarla; a otro
      miembro solo se le explica la situación, sobre una silueta sin datos.
#}
{% block content %}
{% import 'partials/macros/_tour.html.twig' as tour %}

{# Tour en tres pasos: selector, ficha (resumen, miembros y zona de peligro)
   y accesos (Dashboard y Nueva cuenta). En móvil el 3 señala el Dashboard
   de la fila del selector, porque «Nueva cuenta» es el FAB, lejos. #}

{# pb-5 en móvil: el FAB flota sobre el final de la página. #}
<div class="pb-5 pb-md-0" {{ tour.attrs('accounts', not isTrashed) }}>

{# Cabecera. Mismo reparto que movimientos y categorías: en escritorio, una
   fila con título, cuenta y, al otro extremo, las acciones; en móvil, título
   y ayuda arriba y la cuenta debajo, a todo el ancho. #}
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="mb-0 h2 me-1">Cuenta</h1>

    <div class="order-1 order-md-2 ms-auto d-flex align-items-center gap-2">
        {# Solo escritorio: en móvil, el Dashboard baja junto al selector y
           «Nueva cuenta» lo sustituye el FAB del final de la página. #}
        <div class="d-none d-md-flex align-items-center gap-2"
             data-tour-step="3"
             data-tour-title="Dashboard y nueva cuenta"
             data-tour-text="Salta al dashboard de esta cuenta o crea otra: personal, conjunta, un viaje... puedes tener tantas como quieras.">
            {# Una cuenta en la papelera no tiene dashboard que abrir. #}
            {% if not isTrashed %}
                <a href="{{ path('dashboard', {account: account.id}) }}" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center">
                    <i class="fa-solid fa-chart-line me-1"></i>Dashboard
                </a>
            {% endif %}
            <a href="{{ path('account_create') }}" class="btn btn-primary btn-sm d-inline-flex align-items-center">
                <i class="fa-solid fa-plus me-1"></i>Nueva cuenta
            </a>
        </div>
        {{ tour.help_button() }}
    </div>

    {# Sin prefijo «Cuenta »: ya lo dice el título. En móvil comparte fila con
       el botón de Dashboard (.account-header__*), que en escritorio va con las
       acciones. #}
    <div class="tx-header__account order-2 order-md-1 d-flex gap-2">
        <div class="account-header__selector">
        {% include 'partials/_account_selector.html.twig' with {
            accounts: accounts,
            current: account,
            route: 'account_show',
            routeParam: 'id',
            trashedAccounts: trashedAccounts,
            groupClass: 'w-100',
            tourStep: 1,
            tourTitle: 'Selector de cuenta',
            tourText: 'Aquí eliges la cuenta que quieres gestionar. Las que mandes a la papelera también aparecen aquí, para restaurarlas o borrarlas.',
        } only %}
        </div>
        {% if not isTrashed %}
            <a href="{{ path('dashboard', {account: account.id}) }}" class="account-header__dash btn btn-outline-primary btn-sm d-inline-flex d-md-none align-items-center justify-content-center"
               data-tour-step="3"
               data-tour-title="Dashboard y nueva cuenta"
               data-tour-text="Salta al dashboard de esta cuenta. Para crear otra, usa el botón + de abajo.">
                <i class="fa-solid fa-chart-line me-1"></i>Dashboard
            </a>
        {% endif %}
    </div>
</div>

{% if receivedInvitations is not empty %}
    {% include 'account/_pending_invitations.html.twig' with {receivedInvitations: receivedInvitations} only %}
{% endif %}

{% if not isTrashed %}

    <div data-tour-step="2"
         data-tour-title="Tu cuenta"
         data-tour-text="Tus datos de la cuenta, los miembros con los que la compartes y la zona de peligro para mandarla a la papelera.">
        {% include 'account/_body.html.twig' with {interactive: true} %}
    </div>

{% else %}

    {# ── Modo papelera ───────────────────────────────────────────────── #}
    <div class="account-trash">
        {# inert: ni foco, ni clics, ni lector de pantalla. #}
        <div class="account-trash__body" inert>
            {% include 'account/_body.html.twig' with {interactive: false, placeholder: not isOwner} %}
        </div>

        <div class="account-trash__overlay">
            <section class="account-trash__panel" aria-labelledby="trashPanelTitle">
                {% if isOwner %}
                    <div class="account-trash__icon" aria-hidden="true"><i class="fa-solid fa-trash"></i></div>
                    <h2 class="h5 fw-normal mb-1" id="trashPanelTitle">En la papelera</h2>
                    <p class="small text-body-secondary mb-3">
                        <strong class="text-body">{{ account.name }}</strong> se envió el {{ account.deletedAt|date('d/m') }} a las {{ account.deletedAt|date('H:i') }}.
                        {% if transactionCount == 0 %}
                            No tiene movimientos.
                        {% elseif transactionCount == 1 %}
                            Su único movimiento se conserva<span class="d-none d-md-inline"> hasta que la elimines</span>.
                        {% else %}
                            Sus {{ transactionCount }} movimientos se conservan<span class="d-none d-md-inline"> hasta que la elimines</span>.
                        {% endif %}
                    </p>

                    <div class="d-grid gap-2">
                        <form method="post" action="{{ path('account_restore', {id: account.id}) }}" class="d-grid"
                              data-controller="confirm"
                              data-action="submit->confirm#submit"
                              data-confirm-message-value="La cuenta «{{ account.name }}» volverá a estar activa. Si más adelante quieres eliminarla de forma permanente, tendrás que enviarla de nuevo a la papelera y esperar 24 horas."
                              data-confirm-text-value="Restaurar"
                              data-confirm-danger-value="false">
                            <input type="hidden" name="_token" value="{{ csrf_token('restore' ~ account.id) }}">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-rotate-left me-1"></i>Restaurar cuenta
                            </button>
                        </form>
                        {% if account.canBePurged %}
                            <button type="button" class="btn btn-outline-danger"
                                    data-bs-toggle="modal" data-bs-target="#purgeModal">
                                <i class="fa-solid fa-trash me-1"></i>Eliminar definitivamente
                            </button>
                        {% else %}
                            {# En gris hasta que pasa el periodo de seguridad; en
                               rojo solo cuando de verdad se puede eliminar. #}
                            <button type="button" class="btn btn-outline-secondary" disabled
                                    aria-describedby="purgeAvailability">
                                <i class="fa-solid fa-lock me-1"></i>Eliminar definitivamente
                            </button>
                        {% endif %}
                    </div>

                    {% if not account.canBePurged %}
                        <p class="small text-body-secondary mt-2 mb-0" id="purgeAvailability">
                            <i class="fa-regular fa-clock me-1" aria-hidden="true"></i>Disponible el {{ account.purgeableAt|date('d/m') }} a las {{ account.purgeableAt|date('H:i') }}
                        </p>
                    {% endif %}
                {% else %}
                    <div class="account-trash__icon" aria-hidden="true"><i class="fa-solid fa-ban"></i></div>
                    <h2 class="h5 fw-normal mb-1" id="trashPanelTitle">Esta cuenta ya no está disponible</h2>
                    <p class="small text-body-secondary mb-3">
                        Su propietario{{ ownerName ? ', ' ~ ownerName ~ ',' : '' }} la ha enviado a la papelera.
                        Podrás volver a usarla si la restaura.
                    </p>
                    <div class="d-grid">
                        <a href="{{ path('account_index') }}" class="btn btn-outline-primary">Ir a otra cuenta</a>
                    </div>
                {% endif %}
            </section>
        </div>
    </div>

    {# Borrado permanente con confirmación por nombre. #}
    {% if isOwner and account.canBePurged %}
        <div class="modal fade" id="purgeModal" tabindex="-1" aria-labelledby="purgeModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content bg-body-tertiary">
                    <form method="post" action="{{ path('account_destroy', {id: account.id}) }}"
                          data-controller="confirm-match"
                          data-confirm-match-expected-value="{{ account.name }}">
                        <div class="modal-header">
                            <h5 class="modal-title" id="purgeModalLabel">Eliminar definitivamente</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                        </div>
                        <div class="modal-body p-4">
                            <div class="alert alert-danger d-flex align-items-center gap-2 py-2">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                <span>Se borrarán la cuenta y todos sus movimientos. <strong>Esta acción no se puede deshacer.</strong></span>
                            </div>
                            <label class="form-label small text-muted" for="purgeConfirmName">
                                Escribe <strong>{{ account.name }}</strong> para confirmar
                            </label>
                            <input type="text" id="purgeConfirmName" name="confirm_name" class="form-control" autocomplete="off" required
                                   data-confirm-match-target="input"
                                   data-action="input->confirm-match#check">
                            <input type="hidden" name="_token" value="{{ csrf_token('destroy' ~ account.id) }}">
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-danger" data-confirm-match-target="submit">
                                <i class="fa-solid fa-trash me-1"></i>Eliminar para siempre
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    {% endif %}

{% endif %}

{# Botón flotante de «Nueva cuenta»: sustituye en móvil al de la cabecera. #}
<a href="{{ path('account_create') }}"
   class="dash-fab btn btn-primary rounded-circle shadow position-fixed bottom-0 end-0 m-3 d-flex d-md-none align-items-center justify-content-center"
   aria-label="Nueva cuenta">
    <i class="fa-solid fa-plus"></i>
</a>

</div> {# /tour #}
{% endblock %}
