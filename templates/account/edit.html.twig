{% extends 'base.html.twig' %}

{% block title %}{{ isNew ? 'Nueva cuenta' : 'Editar cuenta' }}{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="mb-4">
            <a href="{{ isNew ? path('account_index') : path('account_show', {id: account.id}) }}" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i>Volver
            </a>
        </div>

        {# Filete superior con el color de la cuenta, como la ficha (.account-card):
           account-form#preview le pone el color que se elija. Sin color aún
           (cuenta nueva), el gris de la ficha hasta que el color-picker preselecciona. #}
        <div class="card border-0 shadow bg-body-tertiary account-card"
             style="--account-color: {{ form.color.vars.value ?: '#6c757d' }}"
             data-controller="account-form"
             data-action="input->account-form#preview">
            {{ form_start(form, {attr: {class: 'needs-validation'}}) }}
                <div class="card-header bg-transparent border-bottom py-3 px-4">
                    <h5 class="mb-0">{{ isNew ? 'Nueva cuenta' : 'Editar cuenta' }}</h5>
                    {% if not isNew %}
                        <small class="text-muted">{{ account.name }}</small>
                    {% endif %}
                </div>
                <div class="card-body p-4">
                    {{ form_row(form.name) }}
                    {{ form_row(form.description) }}
                    <div class="row g-3">
                        <div class="col-md-6">{{ form_row(form.currency) }}</div>
                        <div class="col-md-6">{{ form_row(form.color) }}</div>
                    </div>
                    {% if form.copyTemplates is defined %}
                        <hr class="my-3">
                        {# .account-templates: con el interruptor apagado, la lista
                           de categorías se atenúa (CSS :has, sin JS) #}
                        <div class="account-templates">
                            {% set copy = form.copyTemplates %}
                            <div class="d-flex align-items-start justify-content-between gap-3">
                                <div class="flex-grow-1 min-w-0">
                                    {# El título hace de etiqueta del interruptor, que va a la derecha #}
                                    <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
                                        <label for="{{ copy.vars.id }}" class="fw-semibold mb-0">Plantilla de categorías</label>
                                        <span class="badge rounded-pill text-bg-success fw-normal account-templates__badge">Recomendado</span>
                                    </div>
                                    <p class="small text-body-secondary mb-0">
                                        {% if templates is not empty %}
                                            Añade a esta cuenta tus categorías habituales.
                                        {% else %}
                                            Tu plantilla está vacía: la cuenta empezará sin categorías.
                                        {% endif %}
                                    </p>
                                </div>
                                {# A mano y no con form_widget: el tema de Bootstrap 5 pinta el
                                   checkbox con su etiqueta pegada, y aquí la etiqueta es el título.
                                   d-flex + align-items-center: centrado en el min-height de 1.5rem de
                                   .form-check, que es lo que mide la línea del título #}
                                <div class="form-check form-switch m-0 p-0 flex-shrink-0 d-flex align-items-center">
                                    <input type="checkbox" role="switch"
                                           class="form-check-input account-templates__switch"
                                           id="{{ copy.vars.id }}" name="{{ copy.vars.full_name }}"
                                           value="{{ copy.vars.value }}" {{ copy.vars.checked ? 'checked' }}>
                                </div>
                                {% do copy.setRendered %}
                            </div>

                            {# Fuera de la fila del título: la lista ocupa todo el ancho,
                               también el que queda bajo el interruptor #}
                            {% if templates is not empty %}
                                {# Despliegue animado: details-toggle anima la altura del
                                   target content, que va sin padding (no bajaría de él y
                                   saltaría al cerrar). La separación con el summary, en el
                                   div de dentro (pt-2) y no como margen de la lista #}
                                <details class="account-templates__details mt-2" data-controller="details-toggle">
                                    <summary class="small" data-action="click->details-toggle#toggle">
                                        Ver las {{ templates|length }} categorías
                                        <i class="fa-solid fa-chevron-down ms-1 account-templates__chevron"></i>
                                    </summary>
                                    <div data-details-toggle-target="content">
                                        <div class="pt-2">
                                            <ul class="account-templates__list list-unstyled mb-0">
                                                {% for template in templates %}
                                                    <li class="text-truncate" style="--item-color: {{ template.color ?? '#6c757d' }}">{{ template.name }}</li>
                                                {% endfor %}
                                            </ul>
                                            <div class="d-flex justify-content-between align-items-center gap-2 small mt-2">
                                                <span class="text-body-secondary">Podrás editarlas después</span>
                                                <a href="{{ path('category_index', {template: 1}) }}" class="text-decoration-none">
                                                    <i class="fa-solid fa-pen me-1"></i>Editar plantilla
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </details>
                            {% else %}
                                <a href="{{ path('category_index', {template: 1}) }}" class="d-inline-block small mt-2 text-decoration-none">
                                    <i class="fa-solid fa-pen me-1"></i>Editar plantilla
                                </a>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
                <div class="card-footer bg-transparent border-top d-flex gap-2 justify-content-center py-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-check me-1"></i>{{ isNew ? 'Crear cuenta' : 'Guardar cambios' }}
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
