{% extends 'base.html.twig' %}

{% block title %}Transacciones recurrentes{% endblock %}

{% block content %}
{% set canEdit = is_granted('ACCOUNT_EDIT', currentAccount) %}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('transaction_index', {account: currentAccount.id}) }}">Movimientos</a></li>
        <li class="breadcrumb-item active" aria-current="page">Recurrentes</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2">
        <h4 class="mb-0">
            {# <i class="fa-solid fa-rotate me-2"></i> #}
            Movimientos recurrentes
        </h4>
        {% include 'partials/_account_selector.html.twig' with {
            accounts: accounts,
            current: currentAccount,
        } only %}
    </div>
    {% if canEdit %}
    <a href="{{ path('recurring_create', {account: currentAccount.id}) }}" class="btn btn-primary btn-sm">
        <i class="fa-solid fa-plus me-1"></i>Nuevo recurrente
    </a>
    {% endif %}
</div>

<div class="mb-3">
    <a class="help-toggle collapsed small text-decoration-none d-inline-flex align-items-center gap-1"
       data-bs-toggle="collapse" href="#recurringHelp" role="button"
       aria-expanded="false" aria-controls="recurringHelp">
        <i class="fa-solid fa-caret-down"></i>¿Cómo funcionan los movimientos recurrentes?
    </a>
    <div class="collapse" id="recurringHelp">
        <div class="card card-body bg-body-tertiary mt-2 small text-body-secondary">
            <p class="mb-2">
                Cada vez que llega una fecha del calendario, el movimiento se añade
                automáticamente a tus movimientos, sin que tengas que hacer nada.
            </p>
            <ul class="mb-0 ps-3">
                <li>Si la fecha de inicio ya ha pasado, también se generan los movimientos anteriores.</li>
                <li>Pausar una recurrente detiene la generación. Al reactivarla se retoma desde ese momento, sin crear los movimientos del periodo en pausa.</li>
                <li>Al pasar la fecha de fin deja de generar y se marca como finalizada. Ese último día todavía genera su movimiento.</li>
            </ul>
        </div>
    </div>
</div>

{% if recurrings is empty %}
    <div class="text-center py-5">
        <i class="fa-solid fa-rotate fa-3x text-muted mb-3"></i>
        <h5 class="text-muted">No hay transacciones recurrentes</h5>
        {% if canEdit %}
        <a href="{{ path('recurring_create', {account: currentAccount.id}) }}" class="btn btn-primary mt-2">
            <i class="fa-solid fa-plus me-1"></i>Crear primera recurrente
        </a>
        {% endif %}
    </div>
{% else %}
    <div class="card border shadow-sm">
        <div class="card-header bg-body-tertiary border-bottom">
            <span class="text-muted small">
                {{ recurrings|length }} {{ recurrings|length == 1 ? 'recurrente' : 'recurrentes' }}
            </span>
        </div>

        {# Tabla desktop: visible en md+ #}
        <div class="d-none d-md-block table-responsive">
            {% include 'recurring/_table_desktop.html.twig' %}
        </div>

        {# Cards mobile: visible en < md #}
        <div class="d-md-none">
            {% include 'recurring/_cards_mobile.html.twig' %}
        </div>
    </div>
{% endif %}
{% endblock %}
