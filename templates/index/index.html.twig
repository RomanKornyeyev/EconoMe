{% extends 'base.html.twig' %}

{% block title %}Controla tus finanzas
{% endblock %}

{% block content %}
	<style>
		/* estilos en línea, juzgadme */
		/* ---------- HERO ---------- */
		/* La captura se sale del .container hasta el borde de la ventana (ver .hero-shot).
		   Hace falta recortar a nivel de viewport porque los 100vw incluyen la barra de scroll.
		   Tiene que ser "clip" y no "hidden": "hidden" crearía un contenedor de scroll y
		   rompería el sticky-top del header. */
		html {
			overflow-x: clip;
		}
		.landing-page .hero {
			position: relative;
			padding-bottom: 2rem;
		}
		@media (min-width: 992px) {
			.landing-page .hero {
				padding-bottom: 4rem;
			}
		}
		/* Rejilla propia en vez de .row/.col de Bootstrap: así el bloque que se escapa es
		   hijo directo del .container, que SÍ está centrado en el viewport. Solo en ese caso
		   "50%" (que resuelve contra el bloque contenedor) menos "50vw" deja el borde derecho
		   clavado en el borde de la ventana. Dentro de una columna el 50% resuelve contra la
		   columna, que está descentrada, y el cálculo se va largo. */
		.landing-page .hero-grid {
			display: grid;
			gap: 2.5rem;
		}
		@media (min-width: 992px) {
			/* La columna de texto se mide por su contenido (tope 34rem, el mismo ancho de
			   lectura que .hero-lead) en vez de por una fracción; el 42% solo la frena en
			   pantallas pequeñas. Todo lo que sobra se lo queda la captura, que así arranca
			   siempre alrededor del 46% del ancho en lugar de irse a la derecha en cuanto
			   la pantalla crece. */
			.landing-page .hero-grid {
				grid-template-columns: minmax(0, min(34rem, 42%)) minmax(0, 1fr);
				align-items: center;
				column-gap: 1.5rem;
				margin-right: calc(50% - 50vw);
			}
		}
		.landing-page .hero-glow {
			position: absolute;
			top: -30%;
			right: -8%;
			width: 65%;
			aspect-ratio: 1;
			border-radius: 50%;
			background: radial-gradient(circle, rgba(var(--bs-primary-rgb), .16), transparent 65%);
			pointer-events: none;
		}
		[data-bs-theme="light"] .landing-page .hero-glow {
			opacity: .5;
		}
		.landing-page .hero-badge {
			display: inline-flex;
			align-items: center;
			gap: .5rem;
			padding: .45rem 1rem;
			font-size: .8125rem;
			font-weight: 500;
			color: var(--bs-primary);
			background-color: rgba(var(--bs-primary-rgb), .08);
			border: 1px solid rgba(var(--bs-primary-rgb), .35);
			border-radius: 50rem;
		}
		.landing-page .hero-badge::before {
			content: "";
			width: .5rem;
			height: .5rem;
			border-radius: 50%;
			background-color: var(--bs-primary);
		}
		/* El titular se dimensiona contra el ancho de SU columna, no del viewport:
		   es lo único que garantiza que "¿Sabes en qué se va?" quepa en una línea
		   en todos los breakpoints y el titular quede siempre a dos líneas. */
		.landing-page .hero-copy {
			container-type: inline-size;
		}
		.landing-page .hero-title {
			font-size: clamp(2.15rem, 5vw, 3.5rem); /* respaldo sin container queries */
			font-size: min(9.6cqi, 3.25rem);
			line-height: 1.06;
			letter-spacing: -.02em;
		}
		.landing-page .hero-lead {
			max-width: 34rem;
			font-size: 1.0625rem;
			line-height: 1.6;
		}
		.landing-page .hero-cta {
			box-shadow: 0 .5rem 1.5rem rgba(var(--bs-primary-rgb), .4);
		}
		.landing-page .hero-checks {
			font-size: .875rem;
			column-gap: 1.5rem;
			row-gap: .5rem;
		}
		/* marco tipo ventana de navegador alrededor de la captura */
		.landing-page .hero-shot {
			position: relative;
			overflow: hidden;
			background-color: var(--bs-body-bg);
			border: 1px solid var(--bs-border-color);
			border-radius: .875rem;
			box-shadow: 0 1.25rem 3rem rgba(0, 0, 0, .28);
		}
		@media (min-width: 992px) {
			/* La captura llena la segunda columna, que ya muere en el borde de la ventana.
			   Su borde izquierdo es siempre ventana - ancho, así que para acercarla al texto
			   hay que ensancharla; el alto se compensa subiendo el aspect-ratio del marco.
			   El max-width solo es un tope de cordura para monitores muy anchos: en el rango
			   normal no llega a morder. Se pega a la derecha con justify-self:end, porque el
			   borde derecho tiene que seguir clavado en el borde de la ventana. OJO: aquí NO
			   vale margin-left:auto — en un grid item los márgenes automáticos anulan el
			   estirado y la caja pasa a medirse por su contenido (se quedaba del ancho de la
			   barra con la URL). Por eso el width:100%, que deja el ancho definido. */
			.landing-page .hero-shot {
				width: 100%;
				max-width: 72rem;
				justify-self: end;
				border-right: 0;
				border-top-right-radius: 0;
				border-bottom-right-radius: 0;
			}
		}
		.landing-page .hero-shot-bar {
			display: flex;
			align-items: center;
			gap: .375rem;
			padding: .6rem .9rem;
			background-color: var(--bs-tertiary-bg);
			border-bottom: 1px solid var(--bs-border-color);
		}
		.landing-page .hero-shot-dot {
			width: .625rem;
			height: .625rem;
			border-radius: 50%;
			background-color: var(--bs-secondary-bg);
		}
		.landing-page .hero-shot-url {
			margin-left: .75rem;
			font-family: var(--bs-font-monospace);
			font-size: .75rem;
			color: var(--bs-secondary-color);
		}
		/* la captura va de fondo para que solo se descargue la variante del tema activo */
		.landing-page .hero-shot-media {
			aspect-ratio: 1532 / 879;
			background-image: url("{{ asset('images/econome_hero_pc_light.jpg') }}");
			background-size: cover;
			background-position: top left;
		}
		[data-bs-theme="dark"] .landing-page .hero-shot-media {
			background-image: url("{{ asset('images/econome_hero_pc_dark.jpg') }}");
		}
		@media (min-width: 992px) {
			/* Al ser "cover" y tener el marco una proporción MÁS ESTRECHA que la captura,
			   la imagen se escala por altura y sobra por la derecha: de ahí el corte.
			     fraccion_visible = proporcion_del_marco / proporcion_de_la_captura
			     alto_del_marco   = ancho_del_marco / proporcion_del_marco
			   Las capturas son 1534x876 (1.751) oscura y 1532x879 (1.743) clara, así que
			   1.55 deja ~88% visible en los dos temas.
			   TOPE: 1.74 (la clara, la más estrecha de las dos). Por encima, el marco
			   sería MÁS ancho de proporción que la captura y "cover" cambiaría de eje:
			   se vería el ancho entero y cortaría por abajo. Para bajar más el marco sin
			   perder el corte lateral hay que recortarle alto a las capturas, no subir
			   este número. */
			.landing-page .hero-shot-media {
				aspect-ratio: 1.55;
				max-height: min(78vh, 42rem);
			}
		}
		@media (max-width: 991.98px) {
			/* height, NO max-height. Un max-height sobre una caja con aspect-ratio y ancho
			   automático no se limita a recortar el alto: la restricción se transmite por la
			   proporción y encoge TAMBIÉN el ancho, así que la caja deja de llenar el marco y
			   la captura queda pegada a la izquierda con hueco a la derecha. Con un height fijo
			   el ancho sigue siendo el del marco y "cover" recorta como toca. */
			.landing-page .hero-shot-media {
				height: 26rem;
			}
			/* la captura se corta abajo, difuminada contra el fondo */
			.landing-page .hero-shot::after {
				content: "";
				position: absolute;
				right: 0;
				bottom: 0;
				left: 0;
				height: 4rem;
				background: linear-gradient(to bottom, transparent, var(--bs-body-bg));
				pointer-events: none;
			}
		}
		@media (max-width: 575.98px) {
			/* En móvil el marco se adapta al alto de la captura (height:auto + aspect-ratio),
			   así que se ve entera y sin recorte: es vertical y ya cabe de sobra a lo ancho. */
			.landing-page .hero-shot-media {
				aspect-ratio: 400 / 704;
				height: auto;
				background-image: url("{{ asset('images/econome_hero_mobile_light.jpg') }}");
				background-position: top center;
			}
			[data-bs-theme="dark"] .landing-page .hero-shot-media {
				background-image: url("{{ asset('images/econome_hero_mobile_dark.png') }}");
			}
		}
		/* ---------- SECCIONES ---------- */
		.landing-page .section-eyebrow {
			display: block;
			font-size: .72rem;
			font-weight: 600;
			letter-spacing: .12em;
			text-transform: uppercase;
		}
		.landing-page .section-title {
			font-size: clamp(1.75rem, 3.4vw, 2.5rem);
			line-height: 1.12;
			letter-spacing: -.025em;
			text-wrap: balance;
		}
		.landing-page .section-title-sm {
			font-size: clamp(1.5rem, 2.6vw, 2.125rem);
		}
		.landing-page .section-head,
		.landing-page .section-lead,
		.landing-page .cta-copy {
			max-width: 40rem;
		}
		.landing-page .feature-card {
			transition: transform .2s ease, box-shadow .2s ease;
		}
		.landing-page .feature-card:hover {
			transform: translateY(-4px);
			box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .1) !important;
		}
		.landing-page .feature-icon {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 2.625rem;
			height: 2.625rem;
			font-size: 1.15rem;
		}
		/* mini-maquetas dentro de las tarjetas: puro adorno */
		.landing-page .feature-mock {
			padding: .7rem .8rem;
			background-color: var(--bs-body-bg);
			border: 1px solid var(--bs-border-color);
			border-radius: .55rem;
		}
		.landing-page .feature-dot {
			width: .45rem;
			height: .45rem;
			border-radius: 50%;
		}
		.landing-page .feature-key {
			width: .5rem;
			height: .5rem;
			border-radius: .15rem;
		}
		.landing-page .feature-donut {
			width: 5.5rem;
			height: 5.5rem;
			border-radius: 50%;
			background:
				radial-gradient(closest-side, var(--bs-body-bg) 58%, transparent 59%),
				conic-gradient(var(--bs-success) 0 38%, var(--bs-primary) 38% 60%, var(--bs-danger) 60% 78%, var(--bs-warning) 78% 90%, var(--bs-info) 90% 100%);
		}
		.landing-page .feature-avatar {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 1.75rem;
			height: 1.75rem;
			font-size: .7rem;
			font-weight: 700;
			border: 2px solid var(--bs-body-bg);
		}
		.landing-page .feature-avatar + .feature-avatar {
			margin-left: -.55rem;
		}
		/* separadores de la banda de confianza: apilados abajo, en fila a los lados */
		.landing-page .trust-cell:not(:last-child) {
			border-bottom: 1px solid var(--bs-border-color);
		}
		@media (min-width: 992px) {
			.landing-page .trust-cell:not(:last-child) {
				border-bottom: 0;
				border-inline-end: 1px solid var(--bs-border-color);
			}
		}
		.landing-page .step-num {
			width: 2.25rem;
			height: 2.25rem;
		}
		.landing-page .step-line {
			width: 1px;
			margin: .5rem 0;
			background-color: var(--bs-border-color);
		}
		.landing-page .faq-accordion .accordion-item {
			overflow: hidden;
		}
		.landing-page .cta-glow {
			position: absolute;
			top: -45%;
			right: -12%;
			width: 30rem;
			aspect-ratio: 1;
			border-radius: 50%;
			background: radial-gradient(circle, rgba(var(--bs-primary-rgb), .35), transparent 70%);
			pointer-events: none;
		}
		/* para que las anclas no queden ocultas tras el header sticky */
		.landing-page section[id] {
			scroll-margin-top: 90px;
		}
	</style>

	{% set is_logged = is_granted('IS_AUTHENTICATED_FULLY') or is_granted('IS_AUTHENTICATED_REMEMBERED') %}

	<div
		class="landing-page">

		{# SECCIÓN 1: HERO #}
		<section class="hero">
			<div class="hero-glow" aria-hidden="true"></div>
			<div class="hero-grid position-relative">

				{# Columna de texto #}
				<div class="hero-copy text-center text-lg-start">
					{# <span class="hero-badge">Personal o compartido con quien quieras</span> #}

					<h1 class="hero-title fw-bold mt-3 mb-3">
						Sabes cuánto ganas.<br>
						<span class="text-primary">¿Sabes en qué se va?</span>
					</h1>

					<p class="hero-lead text-body-secondary mb-4 mx-auto mx-lg-0">
						Anota un gasto en cinco segundos y deja que {{ app_name }} te enseñe, mes a mes, a dónde va cada euro. Sin conectar tu banco.
					</p>

					{% if is_logged %}
						<div class="d-grid d-sm-flex flex-wrap gap-3 justify-content-sm-center justify-content-lg-start">
							<a href="{{ path('dashboard') }}" class="btn btn-primary btn-lg hero-cta">Ir a mi dashboard</a>
							<a href="{{ path('transaction_index') }}" class="btn btn-outline-secondary btn-lg">Mis movimientos</a>
						</div>
					{% else %}
						<div class="d-grid d-sm-flex flex-wrap gap-3 justify-content-sm-center justify-content-lg-start">
							<a href="{{ path('app_register') }}" class="btn btn-primary btn-lg hero-cta">Crear cuenta gratis</a>
							<a href="{{ path('app_login') }}" class="btn btn-outline-secondary btn-lg">Iniciar sesión</a>
						</div>
					{% endif %}

					<div class="hero-checks d-flex flex-wrap justify-content-center justify-content-lg-start text-body-secondary mt-3">
						<span><i class="fa-solid fa-check me-1"></i>Gratis, sin tarjeta</span>
						<span><i class="fa-solid fa-check me-1"></i>Sin acceso a tu banco</span>
						<span><i class="fa-solid fa-check me-1"></i>Personal y compartido</span>
					</div>
				</div>

				{# Columna de la captura #}
				<div class="hero-shot">
					<div class="hero-shot-bar">
						<span class="hero-shot-dot"></span>
						<span class="hero-shot-dot"></span>
						<span class="hero-shot-dot"></span>
						<span class="hero-shot-url d-none d-sm-inline">econome.es/dashboard</span>
					</div>
					<div class="hero-shot-media" role="img" aria-label="Dashboard de {{ app_name }} con el balance, los ingresos y gastos del mes y los gráficos por categoría"></div>
				</div>

			</div>
		</section>

		{# SECCIÓN 2: FUNCIONALIDADES #}
		<section id="funcionalidades" class="py-5">
			<div class="section-head mb-5">
				<span class="section-eyebrow text-primary">Funcionalidades</span>
				<h2 class="section-title fw-bold mt-3 mb-3">Anotar es rápido. Entender es lo que cambia el mes.</h2>
				<p class="section-lead text-body-secondary mb-0">
					Tres cosas hacen el trabajo pesado: registrar en segundos, ver a dónde va el dinero, y compartir la cuenta con quien la comparte contigo de verdad.
				</p>
			</div>

			<div class="row g-4">
				{# Registrar #}
				<div class="col-md-6 col-lg-4">
					<div class="card feature-card h-100">
						<div class="card-body p-4">
							<span class="feature-icon rounded-3 bg-primary-subtle border border-primary-subtle text-primary">
								<i class="fa-solid fa-right-left"></i>
							</span>
							<h3 class="h5 fw-bold mt-3 mb-2">Registra en cinco segundos</h3>
							<p class="card-text text-body-secondary mb-0">Importe, categoría, listo. Desde el móvil en la cola del súper o desde el ordenador al final del día.</p>
						</div>
						<div class="card-footer bg-body-tertiary p-4 d-flex flex-column gap-2">
							<div class="feature-mock d-flex align-items-center justify-content-between">
								<span class="d-flex align-items-center gap-2 fw-semibold small">
									<span class="feature-dot bg-success"></span>Mercadona
								</span>
								<span class="fw-bold small text-danger font-monospace">−204,18 €</span>
							</div>
							<div class="feature-mock d-flex align-items-center justify-content-between">
								<span class="d-flex align-items-center gap-2 fw-semibold small">
									<span class="feature-dot bg-primary"></span>Nómina
								</span>
								<span class="fw-bold small text-success font-monospace">+1.800,00 €</span>
							</div>
						</div>
					</div>
				</div>

				{# Ver #}
				<div class="col-md-6 col-lg-4">
					<div class="card feature-card h-100">
						<div class="card-body p-4">
							<span class="feature-icon rounded-3 bg-success-subtle border border-success-subtle text-success">
								<i class="fa-solid fa-chart-pie"></i>
							</span>
							<h3 class="h5 fw-bold mt-3 mb-2">Mira dónde se va</h3>
							<p class="card-text text-body-secondary mb-0">Balance, ingresos y gastos por categoría, mes a mes. El gráfico suele contar algo que no esperabas.</p>
						</div>
						<div class="card-footer bg-body-tertiary p-4 d-flex align-items-center gap-3">
							<span class="feature-donut flex-shrink-0" aria-hidden="true"></span>
							<span class="d-flex flex-column gap-2 small text-body-secondary">
								<span class="d-flex align-items-center gap-2"><span class="feature-key bg-success"></span>Alquiler 38%</span>
								<span class="d-flex align-items-center gap-2"><span class="feature-key bg-primary"></span>Alimentación 22%</span>
								<span class="d-flex align-items-center gap-2"><span class="feature-key bg-danger"></span>Transporte 18%</span>
							</span>
						</div>
					</div>
				</div>

				{# Compartir #}
				<div class="col-md-6 col-lg-4">
					<div class="card feature-card h-100">
						<div class="card-body p-4">
							<span class="feature-icon rounded-3 bg-info-subtle border border-info-subtle text-info">
								<i class="fa-solid fa-users"></i>
							</span>
							<h3 class="h5 fw-bold mt-3 mb-2">Comparte la cuenta</h3>
							<p class="card-text text-body-secondary mb-0">Pareja, piso o viaje: una cuenta conjunta donde los dos anotáis y los dos veis lo mismo. Sin hojas de cálculo.</p>
						</div>
						<div class="card-footer bg-body-tertiary p-4">
							<div class="feature-mock d-flex align-items-center justify-content-between">
								<span>
									<span class="d-block fw-semibold small">Cuenta conjunta</span>
									<span class="d-block text-body-secondary" style="font-size:.75rem">2 personas · 8 recurrentes</span>
								</span>
								<span class="d-flex">
									<span class="feature-avatar rounded-circle bg-primary text-white">R</span>
									<span class="feature-avatar rounded-circle bg-info text-white">L</span>
								</span>
							</div>
						</div>
					</div>
				</div>
			</div>

			{# Fila de apoyo #}
			<div class="row g-3 mt-1">
				<div class="col-md-4">
					<div class="d-flex gap-3 p-3 bg-body-tertiary border rounded-3 h-100">
						<i class="fa-solid fa-rotate text-warning mt-1"></i>
						<span>
							<span class="d-block fw-bold small">Recurrentes automáticos</span>
							<span class="d-block small text-body-secondary mt-1">Nómina, alquiler, suscripciones: se registran solos.</span>
						</span>
					</div>
				</div>
				<div class="col-md-4">
					<div class="d-flex gap-3 p-3 bg-body-tertiary border rounded-3 h-100">
						<i class="fa-solid fa-tags text-danger mt-1"></i>
						<span>
							<span class="d-block fw-bold small">Categorías a tu medida</span>
							<span class="d-block small text-body-secondary mt-1">Empieza con las plantillas o crea las tuyas.</span>
						</span>
					</div>
				</div>
				<div class="col-md-4">
					<div class="d-flex gap-3 p-3 bg-body-tertiary border rounded-3 h-100">
						<i class="fa-solid fa-circle-half-stroke text-body-secondary mt-1"></i>
						<span>
							<span class="d-block fw-bold small">Claro u oscuro</span>
							<span class="d-block small text-body-secondary mt-1">Móvil, tablet y escritorio. Sin instalar nada.</span>
						</span>
					</div>
				</div>
			</div>
		</section>

		{# SECCIÓN 3: CÓMO FUNCIONA #}
		<section id="como-funciona" class="py-5">
			<div class="bg-body-tertiary border rounded-4 p-4 p-lg-5">
				<div class="row g-4 g-lg-5">
					<div class="col-lg-5 col-xl-4">
						<span class="section-eyebrow text-primary">Cómo empiezas</span>
						<h2 class="section-title section-title-sm fw-bold mt-3 mb-3">Del registro al primer gráfico, en una tarde</h2>
						<p class="text-body-secondary">No hay onboarding de diez pantallas ni hay que conectar el banco. Tres pasos y ya estás dentro.</p>
						{% if is_logged %}
							<a href="{{ path('dashboard') }}" class="btn btn-primary hero-cta mt-2">Ir a mi dashboard</a>
						{% else %}
							<a href="{{ path('app_register') }}" class="btn btn-primary hero-cta mt-2">Crear cuenta gratis</a>
						{% endif %}
					</div>

					<div class="col-lg-7 col-xl-8">
						<ol class="step-list list-unstyled m-0">
							<li class="step d-flex gap-3">
								<span class="d-flex flex-column align-items-center flex-shrink-0">
									<span class="step-num rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold">1</span>
									<span class="step-line flex-grow-1"></span>
								</span>
								<span class="pb-4">
									<span class="d-block h6 fw-bold mb-1">Crea tu cuenta</span>
									<span class="d-block text-body-secondary">Email y contraseña. Confirmas en un clic y ya tienes tu dashboard vacío esperando.</span>
								</span>
							</li>
							<li class="step d-flex gap-3">
								<span class="d-flex flex-column align-items-center flex-shrink-0">
									<span class="step-num rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold">2</span>
									<span class="step-line flex-grow-1"></span>
								</span>
								<span class="pb-4">
									<span class="d-block h6 fw-bold mb-1">Elige cuentas y categorías</span>
									<span class="d-block text-body-secondary">Una personal, una conjunta, las que necesites. Las categorías vienen con plantillas: cámbialas cuando quieras.</span>
								</span>
							</li>
							<li class="step d-flex gap-3">
								<span class="d-flex flex-column align-items-center flex-shrink-0">
									<span class="step-num rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold">3</span>
								</span>
								<span>
									<span class="d-block h6 fw-bold mb-1">Anota y deja que cuente</span>
									<span class="d-block text-body-secondary">Cada movimiento alimenta los gráficos. A la segunda semana ya ves el patrón.</span>
								</span>
							</li>
						</ol>
					</div>
				</div>
			</div>
		</section>

		{# SECCIÓN 4: CONFIANZA #}
		<section class="pb-5">
			<div class="row row-cols-1 row-cols-lg-4 g-0 bg-body-tertiary border rounded-3 overflow-hidden">
				<div class="col trust-cell p-4">
					<span class="d-flex align-items-center gap-2 fw-bold small">
						<i class="fa-solid fa-building-columns text-success"></i>Sin conectar tu banco
					</span>
					<span class="d-block small text-body-secondary mt-2">{{ app_name }} nunca pide tus credenciales bancarias.</span>
				</div>
				<div class="col trust-cell p-4">
					<span class="d-flex align-items-center gap-2 fw-bold small">
						<i class="fa-solid fa-shield-halved text-primary"></i>Acceso cifrado
					</span>
					<span class="d-block small text-body-secondary mt-2">Contraseñas cifradas, tokens únicos y protección CSRF.</span>
				</div>
				<div class="col trust-cell p-4">
					<span class="d-flex align-items-center gap-2 fw-bold small">
						<i class="fa-solid fa-wallet text-warning"></i>Gratis, sin límites
					</span>
					<span class="d-block small text-body-secondary mt-2">Sin plan de pago ni tope de movimientos.</span>
				</div>
				<div class="col trust-cell p-4">
					<span class="d-flex align-items-center gap-2 fw-bold small">
						<i class="fa-solid fa-code text-info"></i>Código abierto
					</span>
					<span class="d-block small text-body-secondary mt-2">
						Mira exactamente qué hace la app en
						<a href="{{ app_repository }}" target="_blank" rel="noopener noreferrer">el repositorio</a>.
					</span>
				</div>
			</div>
		</section>

		{# SECCIÓN 5: FAQS #}
		<section id="faq" class="py-5">
			<div class="row g-4 g-lg-5">
				<div class="col-lg-4">
					<span class="section-eyebrow text-primary">Dudas</span>
					<h2 class="section-title section-title-sm fw-bold mt-3 mb-3">Preguntas frecuentes</h2>
					<p class="text-body-secondary mb-0">Lo que más se pregunta antes de crear una cuenta.</p>
				</div>

				<div class="col-lg-8">
					<div class="accordion accordion-flush faq-accordion" id="faqAccordion">
						<div class="accordion-item mb-2 border rounded-3">
							<h3 class="accordion-header">
								<button class="accordion-button fw-bold rounded-3" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse1" aria-expanded="true" aria-controls="faqCollapse1">
									¿{{ app_name }} es gratis de verdad?
								</button>
							</h3>
							<div id="faqCollapse1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
								<div class="accordion-body text-body-secondary">
									Sí. No hay plan de pago, ni tarjeta, ni límite de movimientos. Es un proyecto personal y todas las funciones están disponibles desde el primer día.
								</div>
							</div>
						</div>
						<div class="accordion-item mb-2 border rounded-3">
							<h3 class="accordion-header">
								<button class="accordion-button collapsed fw-bold rounded-3" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse2" aria-expanded="false" aria-controls="faqCollapse2">
									¿Tenéis acceso a mi banco?
								</button>
							</h3>
							<div id="faqCollapse2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
								<div class="accordion-body text-body-secondary">
									No, y no es una opción que exista. {{ app_name }} no se conecta con ninguna entidad ni te pide credenciales bancarias: los movimientos los anotas tú, y por eso la app solo sabe lo que tú le cuentas.
								</div>
							</div>
						</div>
						<div class="accordion-item mb-2 border rounded-3">
							<h3 class="accordion-header">
								<button class="accordion-button collapsed fw-bold rounded-3" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse3" aria-expanded="false" aria-controls="faqCollapse3">
									¿Cómo funcionan las cuentas compartidas?
								</button>
							</h3>
							<div id="faqCollapse3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
								<div class="accordion-body text-body-secondary">
									Añades a otra persona como amiga, la invitas a una cuenta y a partir de ahí los dos registráis y consultáis los mismos movimientos. Va bien para parejas, pisos compartidos o un viaje en grupo.
								</div>
							</div>
						</div>
						<div class="accordion-item mb-2 border rounded-3">
							<h3 class="accordion-header">
								<button class="accordion-button collapsed fw-bold rounded-3" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse4" aria-expanded="false" aria-controls="faqCollapse4">
									¿Qué pasa si me olvido de anotar una semana?
								</button>
							</h3>
							<div id="faqCollapse4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
								<div class="accordion-body text-body-secondary">
									No pasa nada: puedes añadir movimientos con fecha pasada cuando te acuerdes. Y lo que se repite todos los meses (nómina, alquiler, suscripciones) puedes dejarlo como recurrente para que se registre solo aunque tú no entres.
								</div>
							</div>
						</div>
						<div class="accordion-item mb-2 border rounded-3">
							<h3 class="accordion-header">
								<button class="accordion-button collapsed fw-bold rounded-3" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse5" aria-expanded="false" aria-controls="faqCollapse5">
									¿Necesito saber de finanzas para usarla?
								</button>
							</h3>
							<div id="faqCollapse5" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
								<div class="accordion-body text-body-secondary">
									Para nada. Si sabes cuánto te has gastado, ya sabes bastante. Un tutorial guiado te acompaña en los primeros pasos y el resto es anotar y mirar los gráficos.
								</div>
							</div>
						</div>
						<div class="accordion-item mb-2 border rounded-3">
							<h3 class="accordion-header">
								<button class="accordion-button collapsed fw-bold rounded-3" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse6" aria-expanded="false" aria-controls="faqCollapse6">
									¿Qué son los movimientos recurrentes?
								</button>
							</h3>
							<div id="faqCollapse6" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
								<div class="accordion-body text-body-secondary">
									Ingresos o gastos que se repiten cada mes. Los configuras una vez con su periodicidad y {{ app_name }} los va registrando por ti, así no tienes que acordarte del alquiler ni de las suscripciones.
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		{# SECCIÓN 6: LLAMADO A LA ACCIÓN #}
		<section class="pb-5">
			<div class="cta-panel position-relative overflow-hidden bg-primary-subtle border border-primary-subtle rounded-4 p-4 p-lg-5">
				<span class="cta-glow" aria-hidden="true"></span>
				<div class="cta-copy position-relative">
					{% if is_logged %}
						<h2 class="section-title fw-bold mb-3">Tus finanzas te esperan donde las dejaste</h2>
						<p class="text-body-secondary mb-4">Revisa el dashboard del mes o anota ese movimiento que tienes pendiente desde ayer.</p>
						<div class="d-flex align-items-center flex-wrap gap-3">
							<a href="{{ path('dashboard') }}" class="btn btn-primary btn-lg hero-cta">Ir a mi dashboard</a>
							<span class="text-body-secondary">o</span>
							<span class="text-body-secondary"><a href="{{ path('transaction_index') }}">añadir movimiento</a></span>
						</div>
					{% else %}
						<h2 class="section-title fw-bold mb-3">El próximo mes puedes saber en qué se fue</h2>
						<p class="text-body-secondary mb-4">Crea la cuenta, anota tres gastos y mira el gráfico. Sin tarjeta y sin conectar el banco.</p>
						<div class="d-flex align-items-center flex-wrap gap-3">
							<a href="{{ path('app_register') }}" class="btn btn-primary btn-lg hero-cta">Crear cuenta gratis</a>
							<span class="text-body-secondary">o</span>
							<span class="text-body-secondary"><a href="{{ path('app_login') }}">iniciar sesión</a></span>
						</div>
						<div class="hero-checks d-flex flex-wrap text-body-secondary mt-4">
							<span><i class="fa-solid fa-check me-1"></i>Gratis, sin tarjeta</span>
							<span><i class="fa-solid fa-check me-1"></i>Sin acceso a tu banco</span>
							<span><i class="fa-solid fa-check me-1"></i>Código abierto</span>
						</div>
					{% endif %}
				</div>
			</div>
		</section>

	</div>
{% endblock %}
