{#
    Barra inferior de un listado paginado: registros por página, rango visible
    dentro del total y paginador.

    En móvil se apila y se centra, con el paginador arriba —que es lo que se
    toca— y el tamaño de página como enlace dentro del texto del rango, para no
    gastar una fila entera en un control secundario. En lg vuelve a la fila
    única de siempre: tamaño y rango a la izquierda, paginador a la derecha.

    Variables:
    - pagination:       objeto de KnpPaginator (obligatorio)
    - perPageOptions:   tamaños de página seleccionables. Si no se pasa, no se
                        pinta el selector: listados de tamaño fijo (el widget de
                        últimos movimientos del dashboard) usan solo el resto.
    - anchor:           id del listado al que volver al cambiar de tamaño, sin
                        almohadilla; sin él la página salta arriba del todo.
    - itemLabel /
      itemLabelPlural:  nombre de lo que se lista, para el texto del rango.
#}
{% set options     = perPageOptions ?? null %}
{% set anchorHash  = (anchor ?? null) ? '#' ~ anchor : '' %}
{% set label       = itemLabel ?? 'registro' %}
{% set labelPlural = itemLabelPlural ?? 'registros' %}

{# El rango lo calcula KnpPaginator: firstItemNumber/lastItemNumber ya cuentan
   los elementos realmente devueltos, así que la última página y las que se
   piden fuera de rango salen bien sin hacer cuentas aquí. #}
{% set data    = pagination.getPaginationData() %}
{% set shown   = data.currentItemCount|default(0) %}
{% set total   = pagination.getTotalItemCount() %}
{% set perPage = pagination.getItemNumberPerPage() %}

{% macro perPageItems(options, perPage, anchorHash) %}
    {# Cada opción es el enlace a su vista, conservando filtros y orden; se
       vuelve a la página 1 porque la actual puede quedar fuera de rango al
       ampliar el tamaño. #}
    {% for option in options %}
        <li>
            <a class="dropdown-item {{ option == perPage ? 'active' : '' }}"
               href="?{{ app.request.query.all|merge({'perPage': option, 'page': 1})|url_encode }}{{ anchorHash }}">
                {{ option }}
            </a>
        </li>
    {% endfor %}
{% endmacro %}
{% import _self as widgets %}

<div class="pagination-bar mt-3 d-flex flex-column flex-lg-row align-items-center align-items-lg-start justify-content-lg-between gap-2 gap-lg-3">

    {# En móvil el paginador va primero; en lg vuelve a la derecha. #}
    <div class="order-1 order-lg-2">
        {{ knp_pagination_render(pagination) }}
    </div>

    <div class="order-2 order-lg-1 d-flex align-items-center gap-2 text-center text-lg-start">
        {% if options %}
            {# Se monta como un paginador de un solo ítem, no como un botón
               suelto: Bootstrap declara las variables --bs-pagination-* dentro
               de la regla .pagination, así que .page-link solo se pinta bajo ese
               contenedor. De paso, al ser primer y último .page-item a la vez,
               hereda el redondeo de ambos extremos y queda idéntico a los
               botones de al lado. #}
            <ul class="pagination mb-0 d-none d-lg-flex">
                <li class="page-item dropdown">
                    <button type="button" class="page-link dropdown-toggle"
                            data-bs-toggle="dropdown" aria-expanded="false"
                            aria-label="Registros por página">
                        {{ perPage }}
                    </button>
                    <ul class="dropdown-menu">
                        {{ widgets.perPageItems(options, perPage, anchorHash) }}
                    </ul>
                </li>
            </ul>
            <span class="text-muted small d-none d-lg-inline">{{ labelPlural|capitalize }} por página</span>
            <span class="text-muted small d-none d-lg-inline">&nbsp;&nbsp;·&nbsp;&nbsp;</span>
        {% endif %}

        {# py-lg-2 iguala el desplazamiento vertical del texto de .page-link
           (borde + padding), que es contra lo que se alinea en la fila única. #}
        <span class="text-muted small py-lg-2">
            {% if shown == 0 %}
                Sin {{ labelPlural }}
            {% else %}
                Mostrando {{ data.firstItemNumber|number_format(0, ',', '.') }} a
                {{ data.lastItemNumber|number_format(0, ',', '.') }}
                de {{ total|number_format(0, ',', '.') }}
                {{ total == 1 ? label : labelPlural }}
            {% endif %}

            {% if options %}
                {# Mismo selector que el de arriba, pero como enlace dentro de
                   la frase: en móvil no hay ancho para un control aparte. #}
                <span class="dropdown d-lg-none">
                    &nbsp;·&nbsp;
                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline text-decoration-none dropdown-toggle"
                            data-bs-toggle="dropdown" aria-expanded="false"
                            aria-label="Registros por página">
                        {{ perPage }} por página
                    </button>
                    <ul class="dropdown-menu">
                        {{ widgets.perPageItems(options, perPage, anchorHash) }}
                    </ul>
                </span>
            {% endif %}
        </span>
    </div>
</div>
