{#
    Selector de cuenta compartido por las vistas principales.

    Variables:
    - accounts:         lista de cuentas del usuario
    - current:          cuenta activa (null en la vista de plantilla de categorías)
    - label:            texto del botón (por defecto, el nombre de current)
    - route:            si se define, los enlaces usan path(route, {routeParam: id});
                        si no, se conserva la query actual añadiendo ?account=
    - routeParam:       nombre del parámetro de la ruta (por defecto 'account')
    - resetParams:      query params a resetear al cambiar de cuenta (p. ej. {page: 1})
    - trashedAccounts:  cuentas en la papelera. La sección «En papelera» solo se
                        pinta si llega con datos; por defecto no se muestra.
                        Cada una enlaza a su ficha, en modo papelera, desde
                        donde se restaura o se borra.
    - withTemplateItem: añade el ítem «Mi plantilla» (categorías)
    - withCreateItem:   muestra el ítem «Añadir cuenta» (por defecto true)
    - menuEnd:          alinea el desplegable a la derecha
    - groupClass:       clases extra del .btn-group (p. ej. 'w-100' para que
                        ocupe la fila entera en móvil)
    - labelPrefix:      texto delante del nombre en el botón (p. ej. 'Cuenta ').
                        Se omite si el nombre ya empieza por él, y no cuenta
                        para el truncado a 20 caracteres.
    - tourStep / tourTitle / tourText: paso del tour de la página, si aplica
#}
{% set trashed = trashedAccounts ?? [] %}
<div class="btn-group {{ groupClass ?? '' }}" role="group"
     {%- if tourStep is defined %}
     data-tour-step="{{ tourStep }}"
     data-tour-title="{{ tourTitle }}"
     data-tour-text="{{ tourText }}"
     {%- endif %}>
    {% set buttonLabel = (label ?? null) ?: (current ? current.name : '') %}
    {% set prefix = labelPrefix ?? '' %}
    {% if prefix and buttonLabel|lower starts with prefix|lower %}{% set prefix = '' %}{% endif %}
    <button type="button" class="btn btn-sm btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"
            {% if buttonLabel|length > 20 %}title="{{ buttonLabel }}"{% endif %}>
        {# La cuenta elegida está en la papelera (solo pasa en la ficha). #}
        {% if current and current.isDeleted %}<i class="fa-solid fa-trash fa-sm me-1" aria-label="En la papelera:"></i>{% endif %}
        {{ prefix }}{{ buttonLabel|length > 20 ? buttonLabel|slice(0, 20)|trim ~ '…' : buttonLabel }}
    </button>
    <ul class="dropdown-menu account-selector__menu{{ (menuEnd ?? false) ? ' dropdown-menu-end' : '' }}">
        {# Sin papelera hay una sola sección: el título sobraría. #}
        {% if trashed is not empty and accounts is not empty %}
            <li><h6 class="dropdown-header">Activas</h6></li>
        {% endif %}
        {% for acc in accounts %}
            <li>
                <a class="dropdown-item d-flex align-items-center gap-2 {{ current and acc.id == current.id ? 'active' : '' }}"
                   href="{{ route is defined
                        ? path(route, {(routeParam|default('account')): acc.id})
                        : '?' ~ app.request.query.all|merge(resetParams|default({}))|merge({'account': acc.id})|url_encode }}"
                   {% if acc.name|length > 30 %}title="{{ acc.name }}"{% endif %}>
                    <span class="account-selector__dot" style="background-color:{{ acc.color ?? '#6c757d' }}" aria-hidden="true"></span>
                    {{ acc.name|length > 30 ? acc.name|slice(0, 30)|trim ~ '…' : acc.name }}
                </a>
            </li>
        {% endfor %}
        {% if trashed is not empty %}
            {% if accounts is not empty %}<li><hr class="dropdown-divider"></li>{% endif %}
            <li>
                <h6 class="dropdown-header d-flex align-items-center justify-content-between gap-3">
                    En papelera
                    <span class="badge rounded-pill bg-body-secondary text-body-secondary">{{ trashed|length }}</span>
                </h6>
            </li>
            {% import 'account/_macros.html.twig' as accMacros %}
            {% for acc in trashed %}
                <li>
                    <a class="dropdown-item account-selector__trashed d-flex align-items-center gap-2 {{ current and acc.id == current.id ? 'active' : '' }}"
                       href="{{ path('account_show', {id: acc.id}) }}"
                       {% if acc.name|length > 30 %}title="{{ acc.name }}"{% endif %}>
                        <i class="fa-solid fa-trash fa-sm" aria-hidden="true"></i>
                        <span class="text-truncate">{{ acc.name|length > 30 ? acc.name|slice(0, 30)|trim ~ '…' : acc.name }}</span>
                        <small class="ms-auto ps-2 text-nowrap">{{ accMacros.purge_text(acc) }}</small>
                    </a>
                </li>
            {% endfor %}
        {% endif %}
        {% if (accounts is not empty or trashed is not empty) and ((withTemplateItem ?? false) or (withCreateItem ?? true)) %}
            <li><hr class="dropdown-divider"></li>
        {% endif %}
        {% if withTemplateItem ?? false %}
            <li>
                <a class="dropdown-item {{ current is null ? 'active' : '' }}"
                   href="{{ path('category_index', {template: 'true'}) }}">
                    Mi plantilla
                </a>
            </li>
        {% endif %}
        {% if withCreateItem ?? true %}
            <li>
                <a class="dropdown-item" href="{{ path('account_create') }}">
                    <i class="fa-solid fa-plus me-1"></i>Añadir cuenta
                </a>
            </li>
        {% endif %}
    </ul>
</div>
