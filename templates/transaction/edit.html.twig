{% extends 'base.html.twig' %}

{% block title %}{{ isNew ? 'Nuevo movimiento' : 'Editar movimiento' }}{% endblock %}

{# Flatpickr por el campo de fecha de _form_transaction. #}
{% block page_assets %}
    {% include 'partials/assets/_flatpickr.html.twig' %}
{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="mb-4">
            <a href="{{ path('transaction_index', {account: account.id}) }}" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i>Volver
            </a>
        </div>

        <div class="card border-0 shadow bg-body-tertiary">
            {% set formAttr = {class: 'needs-validation'} %}
            {% if isNew %}
                {% set formAttr = formAttr|merge({
                    'data-controller': 'category-suggest',
                    'data-category-suggest-url-value': path('transaction_suggest_category', {account: account.id}),
                }) %}
            {% endif %}
            {{ form_start(form, {attr: formAttr}) }}
                <div class="card-header bg-transparent border-bottom py-3 px-4">
                    <h5 class="mb-0">{{ isNew ? 'Nuevo movimiento' : 'Editar movimiento' }}</h5>
                    <small class="text-muted">{{ account.name }}</small>
                </div>
                <div class="card-body p-4">
                    {% include 'transaction/_form_transaction.html.twig' with {suggest: isNew} %}
                </div>
                <div class="card-footer bg-transparent border-top d-flex gap-2 align-items-center py-3 {{ isNew ? 'justify-content-between' : 'justify-content-center' }}">
                    {% if isNew %}
                        <a href="{{ path('recurring_create', {account: account.id}) }}" class="small text-decoration-none">
                            <i class="fa-solid fa-rotate me-1"></i>Añadir movimiento recurrente
                        </a>
                    {% endif %}
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-check me-1"></i>{{ isNew ? 'Guardar' : 'Guardar cambios' }}
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
